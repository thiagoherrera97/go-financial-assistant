<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Instalação: make watchdog-install (copia para ~/Library/LaunchAgents e carrega). -->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.thiago.finassist</string>
	<key>ProgramArguments</key>
	<array>
		<string>/bin/bash</string>
		<string>__HOME__/Library/Application Support/finassist/watchdog.sh</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>StartInterval</key>
	<integer>120</integer>
	<key>StandardOutPath</key>
	<string>__HOME__/Library/Logs/finassist-watchdog.log</string>
	<key>StandardErrorPath</key>
	<string>__HOME__/Library/Logs/finassist-watchdog.log</string>
</dict>
</plist>
